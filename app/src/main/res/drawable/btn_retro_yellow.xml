<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#CA8A04" />
            <corners android:radius="12dp" />
            <stroke android:width="3dp" android:color="#422006" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FACC15" />
            <corners android:radius="12dp" />
            <stroke android:width="4dp" android:color="#422006" />
            <padding android:left="16dp" android:top="12dp" android:right="16dp" android:bottom="12dp"/>
        </shape>
    </item>

</selector>