<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <layer-list>
            <!-- Borde exterior neón resplandeciente -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="#00E5FF" />
                </shape>
            </item>

            <!-- Fondo oscuro estilo cristal tech -->
            <item
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <gradient
                        android:angle="270"
                        android:endColor="#0F172A"
                        android:startColor="#1E293B" />
                    <stroke
                        android:width="1dp"
                        android:color="#38BDF8" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>