<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- CABECERA CON NOMBRE DEL JEFE Y PISO -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardBackgroundColor="#CC0F172A"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvFloorTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:textColor="#00E5FF"
                        android:textSize="14sp"
                        tools:text="TORRE DE COMBATE • PISO 1" />

                    <TextView
                        android:id="@+id/tvBossNameHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        tools:text="Jefe: Maestra Pokémon" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnStartBattle"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:backgroundTint="#DC2626"
                    android:fontFamily="sans-serif-black"
                    android:text="¡A ATACAR!"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ESCENARIO DE BATALLA -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginHorizontal="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:strokeColor="#00E5FF"
            app:strokeWidth="1.5dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- FONDO DINÁMICO DEL PISO -->
                <ImageView
                    android:id="@+id/ivBattleBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/piso1" />

                <!-- MÁSCARA -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#330F172A" />

                <!-- POKÉMON RIVAL -->
                <LinearLayout
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="12dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#CC0F172A"
                        android:orientation="vertical"
                        android:padding="6dp">

                        <TextView
                            android:id="@+id/tvEnemyName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            tools:text="Machamp" />

                        <ProgressBar
                            android:id="@+id/pbEnemyHp"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="2dp"
                            android:max="100"
                            android:progress="100"
                            android:progressTint="#EF4444" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivEnemySprite"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginTop="4dp"
                        tools:src="@android:drawable/ic_menu_camera" />
                </LinearLayout>

                <!-- POKÉMON JUGADOR -->
                <LinearLayout
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="12dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivPlayerSprite"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginBottom="4dp"
                        tools:src="@android:drawable/ic_menu_camera" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#CC0F172A"
                        android:orientation="vertical"
                        android:padding="6dp">

                        <TextView
                            android:id="@+id/tvPlayerName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            tools:text="Tu Pokémon" />

                        <ProgressBar
                            android:id="@+id/pbPlayerHp"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="2dp"
                            android:max="100"
                            android:progress="100"
                            android:progressTint="#22C55E" />
                    </LinearLayout>
                </LinearLayout>

            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- BITÁCORA DE ATAQUES Y LOGS EN TIEMPO REAL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-bold"
            android:text="Bitácora de Batalla"
            android:textColor="#00E5FF"
            android:textSize="12sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_text_capsule"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvBattleLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                tools:text="¡Presiona '¡A ATACAR!' para iniciar el combate automático!" />
        </ScrollView>

        <!-- RECUADRO INTERACTIVO DE HISTORIAL DE BATALLA -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardHistoryBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:strokeColor="#FACC15"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvHistoryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="📜 VER HISTORIAL DE BATALLAS GUARDADAS"
                    android:textColor="#FACC15"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvHistoryContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:textColor="#CBD5E1"
                    android:textSize="10sp"
                    android:visibility="gone"
                    tools:text="Sin registros guardados." />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</FrameLayout>