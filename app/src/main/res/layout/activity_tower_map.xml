<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- IMAGEN DE FONDO DE LA TORRE -->
    <ImageView
        android:id="@+id/ivTowerMapBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo1"
        android:alpha="0.4"
        android:contentDescription="Torre de combate fondo" />

    <!-- OVERLAY OSCURO PARA LEGIBILIDAD -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B30F172A" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ENCABEZADO ESTILO POKÉMON -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#CC0000"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Icono estrella"
                    android:src="@android:drawable/btn_star_big_on"
                    app:tint="#FBBF24" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TORRE DE COMBATE"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="DERROTA A LOS MAESTROS Y GANA SUS MEDALLAS"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- LISTA DE PISOS -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFloors"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />

    </LinearLayout>

</RelativeLayout>
