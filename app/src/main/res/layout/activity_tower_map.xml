<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- IMAGEN DE FONDO DE LA TORRE -->
    <ImageView
        android:id="@+id/ivTowerMapBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo1"
        android:alpha="0.35"
        android:contentDescription="Torre de combate fondo" />

    <!-- OVERLAY OSCURO PARA LEGIBILIDAD -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B30F172A" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ENCABEZADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TORRE DE COMBATE"
                android:textColor="#FBBF24"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="DERROTA A LOS MAESTROS EN CUALQUIER ORDEN Y GANA SUS MEDALLAS"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- LISTA DE PISOS -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFloors"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />

    </LinearLayout>

</RelativeLayout>
