<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B91C1C"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- HEADER POKÉDEX: LENTE AZUL + LUCES LED -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="8dp">

            <!-- Lente Azul Principal -->
            <View
                android:id="@+id/lensBorder"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/pokedex_lens_outer" />

            <View
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="7dp"
                android:background="@drawable/pokedex_lens_inner" />

            <!-- Luces LED (Rojo, Amarillo, Verde) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginStart="64dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/led_red" />

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/led_yellow" />

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/led_green" />
            </LinearLayout>

            <!-- Botones Superiores Menú / Favs -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnNavMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#22C55E"
                    android:paddingHorizontal="10dp"
                    android:text="MENÚ"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:cornerRadius="18dp" />

                <Button
                    android:id="@+id/btnNavFavorites"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="#EAB308"
                    android:paddingHorizontal="10dp"
                    android:text="★ FAVS"
                    android:textColor="#0F172A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:cornerRadius="18dp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- BARRA DE BÚSQUEDA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@android:drawable/editbox_background"
                android:hint="Buscar por nombre o ID..."
                android:paddingHorizontal="12dp"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSearch"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:backgroundTint="#22C55E"
                android:text="BUSCAR"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- PANTALLA PRINCIPAL MARCO GRIS ESTILO POKÉDEX CLASSIC -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#E2E8F0"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Puntos del Marco Superior -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/led_red" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/led_red" />
                </LinearLayout>

                <!-- PANTALLA INTERNA NEGRA DONDE APARECE EL POKÉMON -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#0F172A"
                    app:cardCornerRadius="10dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvPokemonName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:text="#001 Bulbasaur"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/btnFavorite"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_alignParentEnd="true"
                            android:src="@android:drawable/btn_star_big_off" />

                        <TextView
                            android:id="@+id/tvRarity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/tvPokemonName"
                            android:layout_marginTop="2dp"
                            android:text="Rareza: ◆ Común / Raro"
                            android:textColor="#94A3B8"
                            android:textSize="12sp" />

                        <ImageView
                            android:id="@+id/ivPokemon"
                            android:layout_width="180dp"
                            android:layout_height="180dp"
                            android:layout_below="@id/tvRarity"
                            android:layout_centerHorizontal="true"
                            android:layout_marginVertical="8dp"
                            android:src="@android:drawable/ic_menu_help" />

                        <Button
                            android:id="@+id/btnPlaySound"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_below="@id/ivPokemon"
                            android:backgroundTint="#EAB308"
                            android:text="ESCUCHAR SONIDO"
                            android:textColor="#0F172A"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="8dp" />
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- PANEL INFERIOR DE ESTADÍSTICAS Y DETALLES -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Estadísticas Base"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Estadísticas (Se conservan tus barras y textos) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- PS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="70dp"
                            android:layout_height="wrap_content"
                            android:text="PS"
                            android:textColor="#CBD5E1"
                            android:textSize="11sp" />

                        <ProgressBar
                            android:id="@+id/pbHp"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="8dp"
                            android:layout_weight="1"
                            android:max="255"
                            android:progress="45"
                            android:progressTint="#EF4444" />

                        <TextView
                            android:id="@+id/tvHp"
                            android:layout_width="35dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="45"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Ataque -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="70dp"
                            android:layout_height="wrap_content"
                            android:text="Ataque"
                            android:textColor="#CBD5E1"
                            android:textSize="11sp" />

                        <ProgressBar
                            android:id="@+id/pbAttack"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="8dp"
                            android:layout_weight="1"
                            android:max="255"
                            android:progress="49"
                            android:progressTint="#F97316" />

                        <TextView
                            android:id="@+id/tvAttack"
                            android:layout_width="35dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="49"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Defensa -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="70dp"
                            android:layout_height="wrap_content"
                            android:text="Defensa"
                            android:textColor="#CBD5E1"
                            android:textSize="11sp" />

                        <ProgressBar
                            android:id="@+id/pbDefense"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="8dp"
                            android:layout_weight="1"
                            android:max="255"
                            android:progress="49"
                            android:progressTint="#EAB308" />

                        <TextView
                            android:id="@+id/tvDefense"
                            android:layout_width="35dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="49"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Atq. Esp. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="70dp"
                            android:layout_height="wrap_content"
                            android:text="Atq. Esp."
                            android:textColor="#CBD5E1"
                            android:textSize="11sp" />

                        <ProgressBar
                            android:id="@+id/pbSpAttack"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="8dp"
                            android:layout_weight="1"
                            android:max="255"
                            android:progress="65"
                            android:progressTint="#3B82F6" />

                        <TextView
                            android:id="@+id/tvSpAttack"
                            android:layout_width="35dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="65"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Def. Esp. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="70dp"
                            android:layout_height="wrap_content"
                            android:text="Def. Esp."
                            android:textColor="#CBD5E1"
                            android:textSize="11sp" />

                        <ProgressBar
                            android:id="@+id/pbSpDefense"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="8dp"
                            android:layout_weight="1"
                            android:max="255"
                            android:progress="65"
                            android:progressTint="#22C55E" />

                        <TextView
                            android:id="@+id/tvSpDefense"
                            android:layout_width="35dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="65"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Velocidad -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="70dp"
                            android:layout_height="wrap_content"
                            android:text="Velocidad"
                            android:textColor="#CBD5E1"
                            android:textSize="11sp" />

                        <ProgressBar
                            android:id="@+id/pbSpeed"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="8dp"
                            android:layout_weight="1"
                            android:max="255"
                            android:progress="45"
                            android:progressTint="#EC4899" />

                        <TextView
                            android:id="@+id/tvSpeed"
                            android:layout_width="35dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="45"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"
                    android:text="Descripción"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#0F172A"
                    android:padding="8dp"
                    android:text="Una rara semilla le fue plantada en el lomo al nacer. La planta brota y crece con este Pokémon."
                    android:textColor="#CBD5E1"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"
                    android:text="Evoluciones"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/layoutEvolutions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>