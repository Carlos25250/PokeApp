<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- VIDEO DE FONDO DINÁMICO DE LA APP -->
    <VideoView
        android:id="@+id/videoViewBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- CAPA OSCURA DE SOBREPOSICIÓN PARA MEJORAR LECTURA -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC0F172A" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- CABECERA Y PUNTAJE -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:strokeColor="#00E5FF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.05"
                    android:text="¿QUIÉN ES ESE POKÉMON?"
                    android:textColor="#00E5FF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="RACHA: 0"
                    android:textColor="#FACC15"
                    android:textSize="13sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ESCENARIO AMPLIO DEL POKÉMON -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="290dp"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="10dp"
            app:strokeColor="#FACC15"
            app:strokeWidth="2.5dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- FONDO PANTALLA ANIME -->
                <ImageView
                    android:id="@+id/ivGameBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/whos_that_pokemon_bg" />

                <!-- SPRITE / GIF DEL POKÉMON -->
                <ImageView
                    android:id="@+id/ivPokemonImage"
                    android:layout_width="190dp"
                    android:layout_height="190dp"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="20dp"
                    tools:src="@android:drawable/ic_menu_camera" />

                <!-- INDICADOR DE CARGA -->
                <ProgressBar
                    android:id="@+id/pbLoading"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="#FACC15"
                    android:visibility="gone" />

            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- MENSAJE DE INSTRUCCIÓN -->
        <TextView
            android:id="@+id/tvResultStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="10dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="Selecciona el Pokémon correcto:"
            android:textColor="#E2E8F0"
            android:textSize="13sp" />

        <!-- CONTENEDOR DE OPCIONES -->
        <LinearLayout
            android:id="@+id/layoutOptionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnOption1"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="#1E293B"
                    android:drawableStart="@android:drawable/ic_menu_compass"
                    android:drawableTint="#00E5FF"
                    android:fontFamily="sans-serif-black"
                    android:paddingStart="10dp"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    app:cornerRadius="14dp"
                    app:strokeColor="#00E5FF"
                    app:strokeWidth="1.5dp"
                    tools:text="Squirtle" />

                <Button
                    android:id="@+id/btnOption2"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="#1E293B"
                    android:drawableStart="@android:drawable/ic_menu_compass"
                    android:drawableTint="#00E5FF"
                    android:fontFamily="sans-serif-black"
                    android:paddingStart="10dp"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    app:cornerRadius="14dp"
                    app:strokeColor="#00E5FF"
                    app:strokeWidth="1.5dp"
                    tools:text="Snorlax" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnOption3"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="#1E293B"
                    android:drawableStart="@android:drawable/ic_menu_compass"
                    android:drawableTint="#00E5FF"
                    android:fontFamily="sans-serif-black"
                    android:paddingStart="10dp"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    app:cornerRadius="14dp"
                    app:strokeColor="#00E5FF"
                    app:strokeWidth="1.5dp"
                    tools:text="Magnemite" />

                <Button
                    android:id="@+id/btnOption4"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="#1E293B"
                    android:drawableStart="@android:drawable/ic_menu_compass"
                    android:drawableTint="#00E5FF"
                    android:fontFamily="sans-serif-black"
                    android:paddingStart="10dp"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    app:cornerRadius="14dp"
                    app:strokeColor="#00E5FF"
                    app:strokeWidth="1.5dp"
                    tools:text="Farfetch'd" />
            </LinearLayout>

        </LinearLayout>

        <!-- RESULTADO REVELADO EN GRANDE -->
        <LinearLayout
            android:id="@+id/layoutResultContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1E293B"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:strokeColor="#22C55E"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvResultHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="¡ES UN..."
                        android:textColor="#00E5FF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvRevealedPokemonName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="4dp"
                        android:fontFamily="sans-serif-black"
                        android:textColor="#22C55E"
                        android:textSize="26sp"
                        tools:text="FARFETCH'D!" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/btnNext"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#00E5FF"
                android:fontFamily="sans-serif-black"
                android:text="SIGUIENTE POKÉMON ➔"
                android:textColor="#0F172A"
                android:textSize="13sp"
                app:cornerRadius="14dp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>