<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- FONDO ORIGINAL -->
    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo1" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginBottom="16dp"
                android:src="@android:drawable/ic_menu_compass"
                app:tint="#00E5FF" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#DD0F172A"
                app:cardCornerRadius="20dp"
                app:cardElevation="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- PESTAÑAS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTabLogin"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Iniciar Sesión"
                            android:textColor="#00E5FF"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvTabRegister"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Registrarse"
                            android:textColor="#64748B"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- EMAIL -->
                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_text_capsule"
                        android:hint="Correo electrónico"
                        android:inputType="textEmailAddress"
                        android:paddingHorizontal="16dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#94A3B8"
                        android:textSize="14sp" />

                    <!-- CONTRASEÑA -->
                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_text_capsule"
                        android:hint="Contraseña"
                        android:inputType="textPassword"
                        android:paddingHorizontal="16dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#94A3B8"
                        android:textSize="14sp" />

                    <!-- CAMPOS EXCLUSIVOS DE REGISTRO -->
                    <LinearLayout
                        android:id="@+id/layoutRegisterExtra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <EditText
                            android:id="@+id/etConfirmPassword"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/bg_text_capsule"
                            android:hint="Confirmar contraseña"
                            android:inputType="textPassword"
                            android:paddingHorizontal="16dp"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#94A3B8"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/etBirthDate"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/bg_text_capsule"
                            android:focusable="false"
                            android:hint="Fecha de nacimiento (DD/MM/AAAA)"
                            android:paddingHorizontal="16dp"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#94A3B8"
                            android:textSize="14sp" />

                        <!-- SELECCIÓN DE POKÉMON INICIAL -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="6dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="Elige tu Pokémon Inicial:"
                            android:textColor="#00E5FF"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivStarterBulbasaur"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:layout_margin="4dp"
                                android:background="@drawable/bg_text_capsule"
                                android:padding="6dp" />

                            <ImageView
                                android:id="@+id/ivStarterCharmander"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:layout_margin="4dp"
                                android:background="@drawable/bg_text_capsule"
                                android:padding="6dp" />

                            <ImageView
                                android:id="@+id/ivStarterSquirtle"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:layout_margin="4dp"
                                android:background="@drawable/bg_text_capsule"
                                android:padding="6dp" />

                            <ImageView
                                android:id="@+id/ivStarterPikachu"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:layout_margin="4dp"
                                android:background="@drawable/bg_text_capsule"
                                android:padding="6dp" />

                        </LinearLayout>

                        <CheckBox
                            android:id="@+id/cbTerms"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:buttonTint="#00E5FF"
                            android:text="Acepto los Términos y Condiciones"
                            android:textColor="#E2E8F0"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <Button
                        android:id="@+id/btnSubmit"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:backgroundTint="#00E5FF"
                        android:fontFamily="sans-serif-black"
                        android:text="INICIAR SESIÓN"
                        android:textColor="#0F172A"
                        android:textSize="14sp"
                        app:cornerRadius="12dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

    <!-- OVERLAY DE CARGA CHARIZARD -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E60F172A"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivCharizardLoading"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:scaleType="fitCenter" />

            <ProgressBar
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="8dp"
                android:indeterminateTint="#00E5FF" />

            <TextView
                android:id="@+id/tvLoadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-black"
                android:text="Conectando a Pokédex Network..."
                android:textColor="#00E5FF"
                android:textSize="14sp" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>